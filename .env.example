# Copie para .env e ajuste conforme a loja. Todas as variáveis são opcionais.

# Identidade e localização da loja (ponto de saída/retorno das rotas)
NOME_EMPRESA=Radar Auto Peças
BASE_LAT=-26.508484936938192
BASE_LON=-49.10542231274289
CIDADE_BUSCA=Jaraguá do Sul, SC

# Servidor
HOST=0.0.0.0
PORT=5000

# Roteirização (OSRM público por padrão; pode apontar para um servidor próprio)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
FATOR_ATRASO=1.6
VELOCIDADE_MEDIA_OFFLINE_KMH=25
MINUTOS_POR_PARADA=5

# Rastreamento GPS (OwnTracks)
# Defina um token para exigir autenticação no endpoint /api/gps/owntracks
OWNTRACKS_TOKEN=
GPS_PRECISAO_MAX_M=100
GPS_VELOCIDADE_MAX_KMH=150

# Acesso externo (scripts/windows/tunel_ngrok.bat)
NGROK_DOMAIN=

# Caminhos de dados (padrão: pasta data/)
# DB_PATH=data/radar.db
# ARQUIVO_SESSAO=data/sessao.json
